// Monteiro CRM — Fase 1 (Base)
// Schema evolutivo: novas fases adicionam modelos/campos, nunca reescrevem o que já existe.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Usuários e permissões ----------

enum Role {
  ADMIN // Administrador — acesso total
  GESTOR // Gestor — acesso conforme autorização
  BIA // Bia / Mídia — acesso a clientes e serviços de mídia
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(GESTOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientsCreated              Client[]                 @relation("ClientCreatedBy")
  leadsResponsible            Lead[]                   @relation("LeadResponsible")
  servicesDefault             Service[]                @relation("ServiceDefaultResponsible")
  timelineEvents              TimelineEvent[]          @relation("TimelineCreatedBy")
  quotesCreated               Quote[]                  @relation("QuoteCreatedBy")
  proposalsCreated            Proposal[]               @relation("ProposalCreatedBy")
  prospectsResponsible        ProspectingEntry[]       @relation("ProspectResponsible")
  serviceInstancesResponsible ServiceInstance[]        @relation("ServiceInstanceResponsible")
  serviceInstancesCreated     ServiceInstance[]        @relation("ServiceInstanceCreatedBy")
  tasksAssigned               Task[]                   @relation("TaskAssignedTo")
  tasksCreated                Task[]                   @relation("TaskCreatedBy")
  eventsResponsible           CalendarEvent[]          @relation("EventResponsible")
  eventsCreated               CalendarEvent[]          @relation("EventCreatedBy")
  receivablesCreated          Receivable[]             @relation("ReceivableCreatedBy")
  payablesCreated             Payable[]                @relation("PayableCreatedBy")
  commissions                 Commission[]             @relation("CommissionUser")
  commissionsCreated          Commission[]             @relation("CommissionCreatedBy")
  mediaContentsResponsible    MediaContent[]           @relation("MediaContentResponsible")
  mediaContentsApproved       MediaContent[]           @relation("MediaContentApprovedBy")
  mediaContentsCreated        MediaContent[]           @relation("MediaContentCreatedBy")
  whatsappTemplatesCreated    WhatsAppTemplate[]       @relation("WhatsAppTemplateCreatedBy")
  whatsappMessagesCreated     WhatsAppMessage[]        @relation("WhatsAppMessageCreatedBy")
  instagramMetricsCreated     InstagramMetric[]        @relation("InstagramMetricCreatedBy")
  oauthAuthorizationCodes     OAuthAuthorizationCode[]
  oauthTokens                 OAuthToken[]
  mcpAuditLogs                McpAuditLog[]
  balanceAdjustments          BalanceAdjustment[]      @relation("BalanceAdjustmentCreatedBy")
  contractTemplatesCreated    ContractTemplate[]       @relation("ContractTemplateCreatedBy")
  contractsCreated            Contract[]               @relation("ContractCreatedBy")
  contractVersionsCreated     ContractVersion[]        @relation("ContractVersionCreatedBy")
  contractStatusChanges       ContractStatusChange[]   @relation("ContractStatusChangedBy")
  legalConsultationsCreated   LegalConsultation[]      @relation("LegalConsultationCreatedBy")

  @@map("users")
}

// ---------- Identidade visual / configuração da empresa ----------
// A logo é cadastrada pelo administrador; o sistema nunca cria/altera identidade visual sozinho.

model CompanySettings {
  id        String  @id @default(cuid())
  name      String  @default("Monteiro Assessoria Administrativa")
  slogan    String? // ex.: "A Monteiro Resolve" — cadastrado pelo admin, não fixo no código
  logoData  String? // logo enviada pelo admin (data URI), usada em contratos/orçamentos/PDFs
  whatsapp  String? // número exibido no site público, cadastrado pelo admin
  instagram String? // @ ou link exibido no site público, cadastrado pelo admin
  about     String? // texto "sobre a empresa" do site público, cadastrado pelo admin

  // Qualificação da CONTRATADA nos contratos do Jurídico
  legalName          String? // nome empresarial do MEI, como está no cartão CNPJ
  cnpj               String?
  address            String? // endereço completo da sede
  representativeName String? // quem assina pela Monteiro
  forum              String? // foro de eleição, ex.: "Comarca de Redenção-PA"
  signatureCity      String? // cidade que aparece em "local e data" do contrato
  updatedAt          DateTime @updatedAt

  @@map("company_settings")
}

// ---------- Cliente único (PF/PJ) ----------

enum ClientType {
  PF
  PJ
}

enum ClientStatus {
  ATIVO
  INATIVO
}

model Client {
  id     String       @id @default(cuid())
  type   ClientType
  status ClientStatus @default(ATIVO)

  // Pessoa física
  fullName      String? // Nome completo
  cpf           String?
  rg            String?
  birthDate     DateTime?
  maritalStatus String?
  profession    String?

  // Pessoa jurídica
  legalName         String? // Razão social
  tradeName         String? // Nome fantasia
  cnpj              String?
  stateRegistration String? // Inscrição estadual
  responsibleName   String?
  responsibleCpf    String?
  responsibleRole   String?

  // Endereço (comum a PF/PJ)
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  // Contato (comum a PF/PJ)
  phone     String?
  whatsapp  String?
  email     String?
  instagram String?
  notes     String?

  createdById String?
  createdBy   User?    @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads              Lead[]
  timelineEvents     TimelineEvent[]
  quotes             Quote[]
  proposals          Proposal[]
  contracts          Contract[]
  legalConsultations LegalConsultation[]
  serviceInstances   ServiceInstance[]
  tasks              Task[]
  calendarEvents     CalendarEvent[]
  receivables        Receivable[]
  commissions        Commission[]
  mediaContents      MediaContent[]
  whatsappMessages   WhatsAppMessage[]

  @@unique([cpf])
  @@unique([cnpj])
  @@index([whatsapp])
  @@map("clients")
}

// ---------- Leads / prospecção ----------

enum LeadTemperature {
  FRIO
  MORNO
  QUENTE
}

// Etapas do funil (Fase 2 usa isso no Kanban); já modelado agora para não retrabalhar o schema depois.
enum LeadStage {
  NOVO_LEAD
  PRIMEIRO_CONTATO
  EM_ATENDIMENTO
  INTERESSADO
  ORCAMENTO_ENVIADO
  NEGOCIACAO
  CONTRATADO
  PERDIDO
}

model Lead {
  id                String          @id @default(cuid())
  name              String
  whatsapp          String?
  phone             String?
  instagram         String?
  city              String?
  clientTypeGuess   ClientType? // se o interesse é como PF ou PJ
  serviceInterestId String?
  serviceInterest   Service?        @relation(fields: [serviceInterestId], references: [id])
  origin            String? // de onde veio o lead (indicação, instagram, site, etc.)
  responsibleId     String?
  responsible       User?           @relation("LeadResponsible", fields: [responsibleId], references: [id])
  temperature       LeadTemperature @default(MORNO)
  stage             LeadStage       @default(NOVO_LEAD)

  contactDate     DateTime  @default(now())
  lastContactDate DateTime?
  nextContactDate DateTime?
  notes           String?

  clientId String? // preenchido quando o lead é convertido em cliente
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals          Proposal[]
  prospectingEntries ProspectingEntry[]

  @@index([stage])
  @@index([temperature])
  @@map("leads")
}

// ---------- Catálogo de serviços (configurável, sem preços fixos no código) ----------

enum PricingMode {
  FIXO // mostra o defaultPrice normalmente
  A_PARTIR_DE // mostra "a partir de R$ X" no site público
  ORCAMENTO // mostra "sob orçamento" no site público, sem valor
}

model Service {
  id                String      @id @default(cuid())
  name              String
  category          String?
  description       String?
  defaultPrice      Decimal? // configurável pelo admin
  defaultTermDays   Int? // prazo padrão em dias
  checklistTemplate String? // JSON com os itens padrão do checklist deste serviço
  pricingMode       PricingMode @default(FIXO) // como o preço aparece no site público
  active            Boolean     @default(true)

  defaultResponsibleId String?
  defaultResponsible   User?   @relation("ServiceDefaultResponsible", fields: [defaultResponsibleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads              Lead[]
  quoteItems         QuoteItem[]
  proposals          Proposal[]
  prospectingEntries ProspectingEntry[]
  serviceInstances   ServiceInstance[]
  contracts          Contract[]

  @@map("services")
}

// ---------- Linha do tempo única do cliente ----------

model TimelineEvent {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String // ex.: LEAD_CRIADO, ORCAMENTO_ENVIADO, CONTRATO_GERADO, PAGAMENTO_RECEBIDO...
  description String
  createdById String?
  createdBy   User?    @relation("TimelineCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("timeline_events")
}

// ---------- Fase 2: Comercial ----------
// Orçamento → Proposta → Contratação. Segue o mesmo cadastro único de cliente.

enum QuoteStatus {
  RASCUNHO
  ENVIADO
  VISUALIZADO
  EM_NEGOCIACAO
  APROVADO
  RECUSADO
  EXPIRADO
  CANCELADO
}

model Quote {
  id       String      @id @default(cuid())
  number   Int // número sequencial de exibição, atribuído na criação
  clientId String
  client   Client      @relation(fields: [clientId], references: [id])
  status   QuoteStatus @default(RASCUNHO)

  paymentTerms String? // forma de pagamento
  validUntil   DateTime? // validade do orçamento
  notes        String?

  sentAt      DateTime?
  respondedAt DateTime?

  createdById String?
  createdBy   User?    @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            QuoteItem[]
  serviceInstances ServiceInstance[]
  receivables      Receivable[]
  contracts        Contract[]

  @@index([status])
  @@index([clientId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String // preenchido a partir do serviço, editável
  quantity    Int      @default(1)
  unitPrice   Decimal
  termDays    Int?

  @@map("quote_items")
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  APROVADA
  RECUSADA
  EXPIRADA
  CANCELADA
}

model Proposal {
  id        String         @id @default(cuid())
  number    Int // número sequencial de exibição, atribuído na criação
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id])
  serviceId String?
  service   Service?       @relation(fields: [serviceId], references: [id])
  status    ProposalStatus @default(RASCUNHO)

  demand       String // problema / demanda do cliente
  solution     String // solução proposta
  scope        String? // escopo
  termText     String? // prazo (texto livre: "30 dias", "até dezembro"...)
  investment   Decimal? // investimento
  paymentTerms String? // forma de pagamento
  validUntil   DateTime? // validade da proposta
  notes        String?

  createdById String?
  createdBy   User?    @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceInstances ServiceInstance[]

  @@index([status])
  @@index([clientId])
  @@map("proposals")
}

// ---------- Fase 2: Prospecção ativa ----------
// Listas de empresas/pessoas potenciais, anteriores ao estágio de Lead.

model ProspectingEntry {
  id                 String   @id @default(cuid())
  name               String
  segment            String?
  city               String?
  contactName        String?
  whatsapp           String?
  instagram          String?
  potentialServiceId String?
  potentialService   Service? @relation(fields: [potentialServiceId], references: [id])
  responsibleId      String?
  responsible        User?    @relation("ProspectResponsible", fields: [responsibleId], references: [id])

  contactDate     DateTime?
  result          String? // resultado do contato
  nextContactDate DateTime?
  notes           String?

  convertedLeadId String? // preenchido quando vira Lead
  convertedLead   Lead?   @relation(fields: [convertedLeadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prospecting_entries")
}

// ---------- Fase 4: Operacional ----------
// Abertura do serviço a partir de um orçamento/proposta aprovado, com
// checklist puxado do catálogo, tarefas e agenda. Financeiro (contas a
// receber) fica para a Fase 5 — não é criado aqui.

enum ServiceInstanceStatus {
  ABERTO
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDO
  CANCELADO
}

model ServiceInstance {
  id       String @id @default(cuid())
  number   Int // número sequencial de exibição, atribuído na criação
  title    String
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  status        ServiceInstanceStatus @default(ABERTO)
  responsibleId String?
  responsible   User?                 @relation("ServiceInstanceResponsible", fields: [responsibleId], references: [id])

  price       Decimal?
  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?
  notes       String?

  createdById String?
  createdBy   User?    @relation("ServiceInstanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklistItems ChecklistItem[]
  tasks          Task[]
  receivables    Receivable[]
  commissions    Commission[]
  contracts      Contract[]

  @@index([status])
  @@index([clientId])
  @@index([dueDate])
  @@map("service_instances")
}

model ChecklistItem {
  id                String          @id @default(cuid())
  serviceInstanceId String
  serviceInstance   ServiceInstance @relation(fields: [serviceInstanceId], references: [id], onDelete: Cascade)
  description       String
  done              Boolean         @default(false)
  doneAt            DateTime?
  order             Int             @default(0)

  @@map("checklist_items")
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  dueDate      DateTime?
  status       TaskStatus @default(PENDENTE)
  completedAt  DateTime?

  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id])
  serviceInstanceId String?
  serviceInstance   ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])

  createdById String?
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum CalendarEventType {
  ATENDIMENTO
  REUNIAO
  PRAZO
  ENTREGA
  PROSPECCAO
  TAREFA
  PUBLICACAO
  GRAVACAO
  RETORNO_CLIENTE
}

enum CalendarEventStatus {
  PENDENTE
  CONCLUIDO
  NAO_REALIZADO
}

model CalendarEvent {
  id      String            @id @default(cuid())
  title   String
  type    CalendarEventType
  startAt DateTime
  endAt   DateTime?

  clientId      String?
  client        Client? @relation(fields: [clientId], references: [id])
  responsibleId String?
  responsible   User?   @relation("EventResponsible", fields: [responsibleId], references: [id])
  notes         String?

  // Concluir na agenda: quando foi feito e uma observação curta do resultado.
  status      CalendarEventStatus @default(PENDENTE)
  completedAt DateTime?
  result      String?

  // Publicação ligada a um conteúdo do calendário de mídia.
  mediaContentId String?
  mediaContent   MediaContent? @relation(fields: [mediaContentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt])
  @@index([status])
  @@index([mediaContentId])
  @@map("calendar_events")
}

// ---------- Fase 5: Financeiro ----------
// Contas a receber, a pagar, contas/carteiras e comissões. Categorias e
// contas são cadastradas pelo administrador — nada fixo no código.

model FinancialAccount {
  id     String  @id @default(cuid())
  name   String
  type   String? // Caixa, Conta bancária, Conta PJ, Carteira digital... livre
  active Boolean @default(true)

  // Saldo inicial da conta no momento do cadastro (ex.: saldo já existente no banco
  // quando a empresa começou a usar o sistema) — não é receita, não entra em
  // faturamento/contas a receber, só soma no saldo atual da conta.
  openingBalance   Decimal?
  openingBalanceAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivables        Receivable[]
  payables           Payable[]
  commissions        Commission[]
  balanceAdjustments BalanceAdjustment[]

  @@map("financial_accounts")
}

// Conferência do saldo com o banco. Guarda a diferença em vez de mexer no saldo
// inicial: mudar saldo inicial + data daria divergência com lançamentos do mesmo
// dia. Não é faturamento nem despesa: não entra na meta nem em relatórios de receita.
model BalanceAdjustment {
  id         String           @id @default(cuid())
  accountId  String
  account    FinancialAccount @relation(fields: [accountId], references: [id])
  amount     Decimal // diferença: saldo real informado menos saldo calculado
  newBalance Decimal // saldo real informado
  reason     String?

  createdById String?
  createdBy   User?    @relation("BalanceAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("balance_adjustments")
}

enum ReceivableStatus {
  PENDENTE
  RECEBIDO
  CANCELADO
}

model Receivable {
  id       String  @id @default(cuid())
  number   Int // número sequencial de exibição, atribuído na criação
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  serviceInstanceId String?
  serviceInstance   ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])
  quoteId           String?
  quote             Quote?           @relation(fields: [quoteId], references: [id])
  contractId        String?
  contract          Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)

  description   String
  amount        Decimal
  dueDate       DateTime?
  receivedAt    DateTime?
  paymentMethod String?
  accountId     String?
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  status        ReceivableStatus  @default(PENDENTE)
  notes         String?

  category     String? // categoria financeira — livre
  businessLine String? // linha de negócio (assessoria, sites, educação...) — só para consulta, nunca muda a meta

  // Estorno: nada se apaga. O lançamento original ganha reversedAt e o inverso aponta para ele.
  reversedAt        DateTime?
  reversesPayableId String? // preenchido quando esta entrada é o estorno de uma saída (não conta como faturamento)

  createdById String?
  createdBy   User?    @relation("ReceivableCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([contractId])
  @@map("receivables")
}

enum PayableStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model Payable {
  id          String  @id @default(cuid())
  number      Int // número sequencial de exibição, atribuído na criação
  description String
  category    String? // categoria financeira — livre, configurável
  supplier    String? // fornecedor

  amount    Decimal
  dueDate   DateTime?
  paidAt    DateTime?
  accountId String?
  account   FinancialAccount? @relation(fields: [accountId], references: [id])
  status    PayableStatus     @default(PENDENTE)
  notes     String?

  reversedAt           DateTime?
  reversesReceivableId String? // preenchido quando esta saída é o estorno de uma entrada (abate do faturamento)

  createdById String?
  createdBy   User?    @relation("PayableCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@map("payables")
}

// Salário/fixo, comissão e outros pagamentos ficam em categorias separadas —
// nunca misturados, conforme a operação da Bia exige.
enum CommissionCategory {
  SALARIO_FIXO
  COMISSAO
  OUTRO_PAGAMENTO
}

enum CommissionStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model Commission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CommissionUser", fields: [userId], references: [id])

  serviceInstanceId String?
  serviceInstance   ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id])

  category   CommissionCategory @default(COMISSAO)
  baseAmount Decimal? // valor base do serviço (para cálculo percentual)
  percentage Decimal? // percentual aplicado
  amount     Decimal // valor final do pagamento
  status     CommissionStatus   @default(PENDENTE)
  date       DateTime           @default(now())
  paidAt     DateTime?
  notes      String?
  payableId  String?            @unique // saída no caixa gerada ao pagar; sem ela, a comissão paga é histórico antigo
  accountId  String? // conta de onde o valor sai; usada ao pagar
  account    FinancialAccount?  @relation(fields: [accountId], references: [id])

  createdById String?
  createdBy   User?    @relation("CommissionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@map("commissions")
}

// ---------- Fase 6: Bia / Mídia ----------
// Calendário de conteúdo por cliente. Tipo e plataforma são texto livre
// (cadastrados pela Bia/admin), sem lista fixa inventada. Sem integração real
// com redes sociais — publicação é registrada manualmente após acontecer.

enum MediaContentStatus {
  IDEIA
  EM_PRODUCAO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
  PUBLICADO
  CANCELADO
}

model MediaContent {
  id     String @id @default(cuid())
  number Int

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  title       String
  description String?
  type        String? // ex.: Post, Stories, Reels, Vídeo, Arte — livre
  platform    String? // ex.: Instagram, Facebook, TikTok — livre

  scheduledDate DateTime?
  status        MediaContentStatus @default(IDEIA)

  responsibleId String?
  responsible   User?   @relation("MediaContentResponsible", fields: [responsibleId], references: [id])

  approvalNotes String?
  approvedById  String?
  approvedBy    User?     @relation("MediaContentApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  publishedAt DateTime?
  link        String? // link do conteúdo publicado, preenchido manualmente

  notes String?

  calendarEvents CalendarEvent[]

  createdById String?
  createdBy   User?    @relation("MediaContentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@map("media_contents")
}

// ---------- Fase 7: WhatsApp (preparação) ----------
// Não existe integração real com a API do WhatsApp Business — isto é uma
// biblioteca de modelos de mensagem e um registro manual de histórico de
// conversas, para manter tudo no cadastro único do cliente. O envio real
// continua sendo feito pelo WhatsApp normal; o usuário registra aqui depois.

model WhatsAppTemplate {
  id       String  @id @default(cuid())
  name     String
  category String?
  content  String // texto com {{TOKENS}} do cliente
  active   Boolean @default(true)

  createdById String?
  createdBy   User?    @relation("WhatsAppTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages WhatsAppMessage[]

  @@map("whatsapp_templates")
}

enum WhatsAppDirection {
  ENVIADA
  RECEBIDA
}

model WhatsAppMessage {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  templateId String?
  template   WhatsAppTemplate? @relation(fields: [templateId], references: [id])

  direction WhatsAppDirection @default(ENVIADA)
  content   String
  sentAt    DateTime          @default(now())

  createdById String?
  createdBy   User?    @relation("WhatsAppMessageCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([sentAt])
  @@map("whatsapp_messages")
}

// ---------- Instagram (métricas manuais para acompanhar crescimento) ----------
// Sem integração com a API do Instagram/Meta — a Bia/admin registra os
// números periodicamente (seguidores, interações, alcance) para alimentar
// os gráficos de evolução e apoiar decisões de estratégia de conteúdo.

model InstagramMetric {
  id            String   @id @default(cuid())
  date          DateTime
  followers     Int
  posts         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  reach         Int      @default(0)
  profileVisits Int      @default(0)
  notes         String? // o que foi feito no período (campanha, conteúdo, estratégia)

  createdById String?
  createdBy   User?    @relation("InstagramMetricCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("instagram_metrics")
}

// ---------- Fase 8: Conector MCP (acesso do Claude ao CRM) ----------
// Servidor MCP remoto (/api/mcp) protegido por OAuth 2.1 — cliente público +
// PKCE + Dynamic Client Registration, nos moldes esperados por conectores
// personalizados do claude.ai. Nenhum segredo de cliente é emitido; tokens
// ficam guardados só como hash. O acesso é sempre amarrado a um usuário
// (quem aprovou o consentimento), nunca anônimo.

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  redirectUris String[]
  clientName   String?

  createdAt DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  tokens             OAuthToken[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id       String      @id @default(cuid())
  codeHash String      @unique
  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

model OAuthToken {
  id       String      @id @default(cuid())
  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenHash  String? @unique
  refreshTokenHash String? @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("oauth_tokens")
}

// Histórico das ações feitas pelo Claude via MCP — exibido em
// Configurações e usado para carimbar "(via Claude)" na linha do tempo do cliente
// quando a ação está ligada a um cliente.
model McpAuditLog {
  id      String  @id @default(cuid())
  tool    String
  summary String
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])

  entity   String? // ex.: Payable, Client — registros antigos ficam sem estes campos
  entityId String?
  oldValue Json?
  newValue Json?
  source   String  @default("Claude") // "Claude" ou "usuário"

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("mcp_audit_logs")
}

// ---------- Metas ----------
// A meta conta dinheiro recebido, de qualquer linha de negócio. Sem linha nesta
// tabela, a meta mensal é o salário mínimo do ano e a semanal é calculada dela.

enum GoalType {
  MENSAL
  SEMANAL
}

model Goal {
  id          String   @id @default(cuid())
  type        GoalType
  periodStart DateTime // dia 1 do mês (MENSAL) ou segunda-feira (SEMANAL), à meia-noite UTC
  periodEnd   DateTime
  amount      Decimal? // valor definido à mão; vazio quando automatic = true
  automatic   Boolean  @default(true)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, periodStart])
  @@map("goals")
}

// Editável por ano na tela de Metas, para atualizar em janeiro sem mexer em código.
model YearlyConfig {
  id             String  @id @default(cuid())
  year           Int     @unique
  minimumWage    Decimal
  meiAnnualLimit Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("yearly_configs")
}

// ---------- Jurídico: contratos, modelos e orientações ----------
// O funcionário Jurídico (e as telas em /juridico) montam o contrato a partir
// de um modelo e dos dados do CRM. Nada de dado de cliente é inventado: o que
// falta é pedido antes de gerar. Cada alteração vira uma versão nova e cada
// mudança de status fica registrada.

enum ContractStatus {
  RASCUNHO
  ENVIADO
  ASSINADO
  VIGENTE
  ENCERRADO
  RESCINDIDO
}

enum ContractKind {
  CONTRATO // numerado MON-AAAA-NNN
  DOCUMENTO // briefing e outros documentos sem valor contratual, numerados DOC-AAAA-NNN
}

model ContractTemplate {
  id             String       @id @default(cuid())
  baseTemplateId String // agrupa as versões de um mesmo modelo
  slug           String? // chave estável usada pelo conector (ex.: "criacao-site")
  name           String
  kind           ContractKind @default(CONTRATO)
  category       String?
  description    String? // quando usar este modelo
  version        Int          @default(1)
  active         Boolean      @default(true)
  content        String // corpo com {{campos}} — editado pelo admin
  fieldsSchema   String // JSON: [{ key, label, type, required, default?, hint? }]

  legacyDocumentTemplateId String? @unique // id do modelo no sistema antigo (Documentos, já removido)

  createdById String?
  createdBy   User?    @relation("ContractTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]

  @@index([baseTemplateId])
  @@index([slug])
  @@map("contract_templates")
}

model Contract {
  id       String       @id @default(cuid())
  code     String       @unique // MON-2026-001 / DOC-2026-001
  kind     ContractKind @default(CONTRATO)
  year     Int
  sequence Int

  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id])
  clientId   String
  client     Client           @relation(fields: [clientId], references: [id])

  quoteId           String?
  quote             Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceInstanceId String?
  serviceInstance   ServiceInstance? @relation(fields: [serviceInstanceId], references: [id], onDelete: SetNull)

  title  String
  status ContractStatus @default(RASCUNHO)

  totalValue   Decimal? // valor do serviço (criação, avulso)
  monthlyValue Decimal? // mensalidade (manutenção, social media, tráfego)
  paymentTerms String?
  startDate    DateTime?
  endDate      DateTime?
  renewalDate  DateTime? // reajuste/renovação

  sentAt          DateTime?
  signedAt        DateTime?
  signatureMethod String? // gov.br, presencial, outra
  endedAt         DateTime?
  endReason       String?

  fieldValues     String // JSON com os valores preenchidos (versão atual)
  renderedContent String // texto final da versão atual
  currentVersion  Int     @default(1)
  notes           String?

  legacyDocumentId String? @unique // id do documento no sistema antigo; /documentos/:id redireciona para cá

  createdById String?
  createdBy   User?    @relation("ContractCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions           ContractVersion[]
  statusChanges      ContractStatusChange[]
  receivables        Receivable[]
  legalConsultations LegalConsultation[]

  @@unique([kind, year, sequence])
  @@index([clientId])
  @@index([status])
  @@index([quoteId])
  @@map("contracts")
}

model ContractVersion {
  id              String   @id @default(cuid())
  contractId      String
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version         Int
  templateVersion Int // versão do modelo usada nesta versão do contrato
  fieldValues     String
  renderedContent String
  reason          String? // o que mudou

  createdById String?
  createdBy   User?    @relation("ContractVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([contractId, version])
  @@map("contract_versions")
}

model ContractStatusChange {
  id         String          @id @default(cuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fromStatus ContractStatus?
  toStatus   ContractStatus
  note       String?

  createdById String?
  createdBy   User?    @relation("ContractStatusChangedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([contractId])
  @@map("contract_status_changes")
}

model LegalConsultation {
  id          String    @id @default(cuid())
  topic       String // assunto curto: "Cliente quer cancelar a manutenção"
  question    String // a dúvida como chegou
  guidance    String // a orientação dada
  needsLawyer Boolean   @default(false) // recomendou procurar advogado
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("LegalConsultationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("legal_consultations")
}
