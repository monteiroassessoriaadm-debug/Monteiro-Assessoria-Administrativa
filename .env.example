# Copie este arquivo para .env e preencha com valores reais.

# String de conexão do banco Postgres (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Segredo usado para assinar os tokens de sessão (JWT). Gere um valor longo
# e aleatório em produção — nunca reaproveite o valor de exemplo.
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria"
